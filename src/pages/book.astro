---
import Layout from '../layouts/Layout.astro';
import BookingApp from '../components/react/booking/BookingApp';
import FindBooking from '../components/react/booking/FindBooking';
import { booking } from '../config/site';
---

<Layout title="Book a court" auroraOpacity={0.45}>
  <section class="mx-auto max-w-6xl px-5 pb-10 pt-14">
    <p data-reveal class="text-sm font-medium uppercase tracking-widest text-aurora">Book a court</p>
    <h1 data-reveal class="mt-2 font-display text-4xl font-semibold tracking-tight sm:text-5xl">
      Find your hour.
    </h1>
    <p data-reveal class="mt-3 max-w-xl text-mist">
      {booking.currencySymbol}{booking.pricePerHour} per court per hour. Tap the hours you want, then pay
      online to lock them in.
    </p>
  </section>

  <section class="mx-auto max-w-6xl px-5 pb-16">
    <BookingApp client:only="react" />
  </section>

  <section class="mx-auto max-w-6xl px-5 pb-32">
    <div class="max-w-lg rounded-3xl border border-line bg-ink-2/70 p-6 backdrop-blur">
      <h2 class="font-display text-xl font-semibold">Already booked?</h2>
      <p class="mb-4 mt-1 text-sm text-mist">Enter your booking reference to check its status.</p>
      <FindBooking client:visible />
    </div>
  </section>
</Layout>
