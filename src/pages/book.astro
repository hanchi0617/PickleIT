---
import Layout from '../layouts/Layout.astro';
import BookingApp from '../components/react/booking/BookingApp';
import { defaultSettings as booking } from '../config/site';
---

<Layout title="Book a court" auroraOpacity={0.45}>
  <section class="mx-auto max-w-6xl px-5 pb-10 pt-14">
    <p data-reveal class="text-sm font-medium uppercase tracking-widest text-aurora">Book a court</p>
    <h1 data-reveal class="mt-2 font-display text-4xl font-semibold tracking-tight sm:text-5xl">
      Find your hour.
    </h1>
    <p data-reveal class="mt-3 max-w-xl text-mist">
      From {booking.currencySymbol}{Math.min(...booking.courts.map((c) => c.pricePerHour))} per court per hour. Tap the hours you want, then pay
      online to lock them in.
    </p>
  </section>

  <section class="mx-auto max-w-6xl px-5 pb-32">
    <BookingApp client:only="react" />
  </section>

</Layout>
