---
import Layout from '../layouts/Layout.astro';
import { site, booking } from '../config/site';

const price = `${booking.currencySymbol}${booking.pricePerHour}`;
const fmtHour = (h: number) => `${((h + 11) % 12) + 1}${h < 12 ? 'AM' : 'PM'}`;
const hours = `${fmtHour(booking.openHour)} – ${fmtHour(booking.closeHour)}`;

const features = [
  {
    title: 'Book in seconds',
    body: 'Pick a court, pick a time, pay online. No account, no phone tag.',
    icon: 'M8 2v3M16 2v3M3.5 9h17M5 4h14a2 2 0 0 1 2 2v13a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2Z',
  },
  {
    title: 'Live availability',
    body: 'The calendar updates the moment a slot is taken, so what you see is what you get.',
    icon: 'M12 6v6l4 2M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z',
  },
  {
    title: 'Three dedicated courts',
    body: 'Purpose-built pickleball courts with proper lines, nets and lighting.',
    icon: 'M3 5h18v14H3zM12 5v14M3 12h18',
  },
];

const steps = [
  { n: '01', title: 'Choose a date', body: 'See every open hour across all three courts.' },
  { n: '02', title: 'Pick your slot', body: 'Tap the hours you want. Your slot is held while you pay.' },
  { n: '03', title: 'Pay and play', body: 'Pay online and get your booking reference instantly.' },
];
---

<Layout>
  <!-- Hero -->
  <section class="relative mx-auto flex min-h-[calc(100dvh-4rem)] max-w-6xl flex-col items-center justify-center px-5 py-24 text-center">
    <p
      data-reveal
      class="mb-6 inline-flex items-center gap-2 rounded-full border border-line bg-white/5 px-4 py-1.5 text-xs text-mist backdrop-blur"
    >
      <span class="size-1.5 animate-pulse rounded-full bg-aurora"></span>
      Courts open today · {hours}
    </p>

    <h1
      data-reveal
      class="font-display text-5xl font-semibold leading-[1.02] tracking-tight sm:text-7xl md:text-8xl"
    >
      Your game.<br />
      <span class="bg-gradient-to-r from-aurora-mint via-aurora to-aurora-teal bg-clip-text text-transparent">
        Your court.
      </span>
    </h1>

    <p data-reveal class="mt-6 max-w-xl text-lg text-mist sm:text-xl">
      {site.tagline}
    </p>

    <div data-reveal class="mt-10 flex flex-col gap-3 sm:flex-row">
      <a
        href="/book"
        data-aurora-boost
        class="group rounded-full bg-aurora px-8 py-4 font-medium text-ink transition hover:shadow-[0_0_40px_rgb(124_255_103/0.55)]"
      >
        Book a court
        <span class="ml-1 inline-block transition-transform group-hover:translate-x-1">→</span>
      </a>
      <a
        href="/courts"
        data-aurora-boost="0.5"
        class="rounded-full border border-line bg-white/5 px-8 py-4 font-medium backdrop-blur transition hover:border-white/25"
      >
        See the courts
      </a>
    </div>

    <p data-reveal class="mt-6 text-sm text-mist">
      From <span class="text-white">{price}</span> per hour · No sign-up needed
    </p>

    <a href="#why" class="absolute bottom-8 text-mist transition hover:text-white" aria-label="Scroll down">
      <svg viewBox="0 0 24 24" class="size-6 animate-bounce" fill="none" stroke="currentColor" stroke-width="1.5">
        <path d="M6 9l6 6 6-6" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </a>
  </section>

  <!-- Why -->
  <section id="why" class="mx-auto max-w-6xl scroll-mt-20 px-5 py-24">
    <div class="max-w-2xl">
      <p data-reveal class="text-sm font-medium uppercase tracking-widest text-aurora">Why The Quad</p>
      <h2 data-reveal class="mt-3 font-display text-4xl font-semibold tracking-tight sm:text-5xl">
        Less hassle. More rallies.
      </h2>
    </div>

    <div class="mt-12 grid gap-4 md:grid-cols-3">
      {features.map((f) => (
        <article
          data-reveal
          data-aurora-boost="0.7"
          class="spotlight rounded-3xl border border-line bg-ink-2/70 p-7 backdrop-blur transition hover:border-aurora/30"
        >
          <span class="grid size-11 place-items-center rounded-2xl bg-aurora/10 text-aurora">
            <svg viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
              <path d={f.icon} />
            </svg>
          </span>
          <h3 class="mt-6 font-display text-xl font-semibold">{f.title}</h3>
          <p class="mt-2 text-mist">{f.body}</p>
        </article>
      ))}
    </div>
  </section>

  <!-- How it works -->
  <section class="mx-auto max-w-6xl px-5 py-24">
    <div class="grid gap-12 md:grid-cols-[1fr_1.4fr] md:gap-20">
      <div>
        <p data-reveal class="text-sm font-medium uppercase tracking-widest text-aurora">How it works</p>
        <h2 data-reveal class="mt-3 font-display text-4xl font-semibold tracking-tight sm:text-5xl">
          Three steps to the court.
        </h2>
        <a data-reveal href="/book" class="mt-8 inline-block text-aurora hover:underline">Start booking →</a>
      </div>
      <ol class="divide-y divide-line border-y border-line">
        {steps.map((s) => (
          <li data-reveal class="group flex gap-6 py-7">
            <span class="font-display text-sm text-mist transition-colors group-hover:text-aurora">{s.n}</span>
            <div>
              <h3 class="font-display text-2xl font-semibold">{s.title}</h3>
              <p class="mt-1 text-mist">{s.body}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Pricing -->
  <section id="pricing" class="mx-auto max-w-6xl scroll-mt-20 px-5 py-24">
    <div
      data-reveal
      data-aurora-boost
      class="spotlight relative overflow-hidden rounded-[2rem] border border-line bg-ink-2/70 p-8 backdrop-blur sm:p-14"
    >
      <div class="grid items-end gap-10 md:grid-cols-2">
        <div>
          <p class="text-sm font-medium uppercase tracking-widest text-aurora">Simple pricing</p>
          <p class="mt-4 font-display text-6xl font-semibold tracking-tight sm:text-7xl">
            {price}<span class="text-2xl text-mist"> / hour</span>
          </p>
          <p class="mt-3 text-mist">Per court. Bring up to four players. Paddles and balls available.</p>
        </div>
        <ul class="space-y-3 text-mist">
          {['Pay securely online', 'Instant booking reference', 'Slot held for you while you pay', 'Book up to 60 days ahead'].map((t) => (
            <li class="flex items-center gap-3">
              <span class="grid size-5 place-items-center rounded-full bg-aurora/15 text-aurora">
                <svg viewBox="0 0 24 24" class="size-3" fill="none" stroke="currentColor" stroke-width="3"><path d="M5 12l5 5L20 7" /></svg>
              </span>
              {t}
            </li>
          ))}
          <li class="pt-4">
            <a href="/book" class="inline-block rounded-full bg-aurora px-6 py-3 font-medium text-ink">Book now</a>
          </li>
        </ul>
      </div>
    </div>
  </section>

  <!-- Visit -->
  <section id="visit" class="mx-auto max-w-6xl scroll-mt-20 px-5 pb-32 pt-12">
    <div class="grid gap-4 md:grid-cols-3">
      {[
        { label: 'Location', value: site.address },
        { label: 'Hours', value: `Daily · ${hours}` },
        { label: 'Contact', value: `${site.phone}\n${site.email}` },
      ].map((c) => (
        <div data-reveal data-aurora-boost="0.4" class="spotlight rounded-3xl border border-line bg-ink-2/60 p-7 backdrop-blur">
          <p class="text-sm text-mist">{c.label}</p>
          <p class="mt-2 whitespace-pre-line font-display text-lg">{c.value}</p>
        </div>
      ))}
    </div>
  </section>
</Layout>
