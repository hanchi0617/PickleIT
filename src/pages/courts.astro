---
import Layout from '../layouts/Layout.astro';
import { booking } from '../config/site';

const price = `${booking.currencySymbol}${booking.pricePerHour}`;

const amenities = [
  'LED court lighting',
  'Regulation nets and lines',
  'Paddle and ball rental',
  'Shaded seating',
  'Drinking water',
  'Restrooms',
];
---

<Layout title="Courts" auroraOpacity={0.7}>
  <section class="mx-auto max-w-6xl px-5 pb-12 pt-20">
    <p data-reveal class="text-sm font-medium uppercase tracking-widest text-aurora">The courts</p>
    <h1 data-reveal class="mt-3 max-w-3xl font-display text-5xl font-semibold tracking-tight sm:text-6xl">
      Three courts, built for good rallies.
    </h1>
    <p data-reveal class="mt-5 max-w-xl text-lg text-mist">
      Every court is {price} per hour and fits up to four players. Pick the one you like, or
      whichever is free.
    </p>
  </section>

  <section class="mx-auto grid max-w-6xl gap-4 px-5 md:grid-cols-3">
    {booking.courts.map((c, i) => (
      <a
        href={`/book?court=${c.id}`}
        data-reveal
        data-aurora-boost="0.8"
        class="spotlight group block overflow-hidden rounded-3xl border border-line bg-ink-2/70 backdrop-blur transition hover:border-aurora/30"
      >
        <!-- Court diagram stands in for a photo until real images are added. -->
        <div class="relative aspect-[4/3] border-b border-line bg-gradient-to-br from-aurora/10 to-transparent p-6">
          <svg viewBox="0 0 200 100" class="h-full w-full text-aurora/60 transition group-hover:text-aurora" fill="none" stroke="currentColor" stroke-width="1.2">
            <rect x="4" y="4" width="192" height="92" rx="2" />
            <line x1="100" y1="4" x2="100" y2="96" stroke-dasharray="3 3" />
            <line x1="70" y1="4" x2="70" y2="96" />
            <line x1="130" y1="4" x2="130" y2="96" />
            <line x1="4" y1="50" x2="70" y2="50" />
            <line x1="130" y1="50" x2="196" y2="50" />
          </svg>
          <span class="absolute left-5 top-5 rounded-full bg-ink/70 px-3 py-1 font-display text-xs backdrop-blur">
            0{i + 1}
          </span>
        </div>
        <div class="flex items-center justify-between p-6">
          <div>
            <h2 class="font-display text-2xl font-semibold">{c.name}</h2>
            <p class="text-mist">{c.note}</p>
          </div>
          <span class="rounded-full border border-line px-4 py-2 text-sm transition group-hover:border-aurora group-hover:bg-aurora group-hover:text-ink">
            Book
          </span>
        </div>
      </a>
    ))}
  </section>

  <section class="mx-auto max-w-6xl px-5 py-24">
    <div class="grid gap-12 md:grid-cols-2">
      <div>
        <h2 data-reveal class="font-display text-3xl font-semibold tracking-tight sm:text-4xl">What's included</h2>
        <p data-reveal class="mt-3 text-mist">Placeholder list. Tell us what the venue actually offers and we'll update it.</p>
      </div>
      <ul class="grid grid-cols-2 gap-3">
        {amenities.map((a) => (
          <li data-reveal class="rounded-2xl border border-line bg-ink-2/60 px-4 py-4 text-sm backdrop-blur">{a}</li>
        ))}
      </ul>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-5 pb-32">
    <h2 data-reveal class="font-display text-3xl font-semibold tracking-tight sm:text-4xl">Good to know</h2>
    <div class="mt-8 grid gap-4 md:grid-cols-3">
      {[
        { q: 'How long is a booking?', a: 'Bookings are by the hour. Select several hours in a row for a longer game.' },
        { q: 'Do I need an account?', a: 'No. Just your name, mobile number and email so we can send your confirmation.' },
        { q: 'What if I need to cancel?', a: 'Cancellation policy coming soon. Contact us with your booking reference.' },
      ].map((f) => (
        <div data-reveal class="rounded-3xl border border-line bg-ink-2/60 p-6 backdrop-blur">
          <h3 class="font-display text-lg font-semibold">{f.q}</h3>
          <p class="mt-2 text-mist">{f.a}</p>
        </div>
      ))}
    </div>
  </section>
</Layout>
