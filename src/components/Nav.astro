---
import { site } from '../config/site';

const links = [
  { href: '/', label: 'Home' },
  { href: '/courts', label: 'Courts' },
  { href: '/#pricing', label: 'Pricing' },
  { href: '/#visit', label: 'Visit' },
];

const path = Astro.url.pathname;
---

<header
  class="sticky top-0 z-40 border-b border-line bg-ink/60 backdrop-blur-xl"
  style="padding-top: env(safe-area-inset-top)"
>
  <nav class="mx-auto flex h-16 max-w-6xl items-center justify-between px-5">
    <a href="/" class="flex items-center gap-2.5 font-display text-lg font-semibold tracking-tight">
      <span class="relative grid size-7 place-items-center rounded-full bg-aurora text-ink">
        <svg viewBox="0 0 24 24" class="size-4" fill="currentColor" aria-hidden="true">
          <circle cx="12" cy="12" r="10" opacity=".25" />
          <circle cx="8" cy="9" r="1.6" /><circle cx="15" cy="8" r="1.6" />
          <circle cx="12" cy="13" r="1.6" /><circle cx="8" cy="16" r="1.6" />
          <circle cx="16" cy="15" r="1.6" />
        </svg>
      </span>
      {site.name}
    </a>

    <div class="hidden items-center gap-8 text-sm text-mist md:flex">
      {links.map((l) => (
        <a
          href={l.href}
          class:list={['transition-colors hover:text-white', path === l.href && 'text-white']}
        >
          {l.label}
        </a>
      ))}
      <a
        href="/book"
        data-aurora-boost
        class="btn btn-primary btn-sm"
      >
        Book a court
      </a>
    </div>

    <button
      id="menu-btn"
      class="btn btn-secondary size-10 !p-0 md:hidden"
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <svg viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path d="M4 7h16M4 12h16M4 17h16" stroke-linecap="round" />
      </svg>
    </button>
  </nav>

  <div id="mobile-menu" class="hidden border-t border-line px-5 pb-6 pt-2 md:hidden">
    {links.map((l) => (
      <a href={l.href} class="block py-3 text-lg text-mist hover:text-white">{l.label}</a>
    ))}
    <a href="/book" class="btn btn-primary btn-block mt-3">
      Book a court
    </a>
  </div>
</header>

<script>
  const btn = document.getElementById('menu-btn');
  const menu = document.getElementById('mobile-menu');
  btn?.addEventListener('click', () => {
    const open = menu?.classList.toggle('hidden') === false;
    btn.setAttribute('aria-expanded', String(open));
  });
  menu?.querySelectorAll('a').forEach((a) =>
    a.addEventListener('click', () => {
      menu.classList.add('hidden');
      btn?.setAttribute('aria-expanded', 'false');
    }),
  );
</script>
