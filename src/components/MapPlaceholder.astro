---
// Stand-in for a real map (e.g. Google Maps or Mapbox embed) until the venue
// address is final. The buttons already open the address in the phone's maps app.
import { site } from '../config/site';

interface Props {
  class?: string;
}
const { class: cls = '' } = Astro.props;
const query = encodeURIComponent(site.address);
---

<div class:list={['card relative overflow-hidden !p-0', cls]}>
  <div class="relative aspect-[16/10] w-full sm:aspect-[16/8]" aria-hidden="true">
    <svg viewBox="0 0 800 400" preserveAspectRatio="xMidYMid slice" class="absolute inset-0 h-full w-full">
      <rect width="800" height="400" fill="#0b1114" />
      <!-- blocks -->
      <g fill="rgb(255 255 255 / 0.035)">
        <rect x="20" y="20" width="150" height="90" rx="6" /><rect x="200" y="20" width="200" height="90" rx="6" />
        <rect x="430" y="20" width="120" height="90" rx="6" /><rect x="580" y="20" width="200" height="90" rx="6" />
        <rect x="20" y="150" width="150" height="110" rx="6" /><rect x="200" y="150" width="90" height="110" rx="6" />
        <rect x="510" y="150" width="270" height="110" rx="6" />
        <rect x="20" y="300" width="270" height="90" rx="6" /><rect x="320" y="300" width="160" height="90" rx="6" />
        <rect x="510" y="300" width="270" height="90" rx="6" />
      </g>
      <!-- park -->
      <rect x="320" y="150" width="160" height="110" rx="10" fill="rgb(124 255 103 / 0.07)" />
      <!-- roads -->
      <g stroke="rgb(255 255 255 / 0.09)" stroke-width="14" fill="none" stroke-linecap="round">
        <path d="M0 130 H800" /><path d="M0 280 H800" /><path d="M185 0 V400" /><path d="M495 0 V400" />
      </g>
      <path d="M0 360 C 200 330, 300 400, 800 340" stroke="rgb(0 184 169 / 0.18)" stroke-width="10" fill="none" />
      <!-- courts at the pin -->
      <g transform="translate(345 172)" stroke="rgb(124 255 103 / 0.55)" stroke-width="1.5" fill="none">
        <rect width="30" height="60" rx="2" /><rect x="40" width="30" height="60" rx="2" /><rect x="80" width="30" height="60" rx="2" />
      </g>
    </svg>

    <!-- pin -->
    <div class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-full">
      <span class="map-pulse absolute left-1/2 top-full size-10 -translate-x-1/2 -translate-y-1/2 rounded-full bg-aurora/30"></span>
      <svg viewBox="0 0 24 24" class="relative size-10 text-aurora drop-shadow-lg" fill="currentColor">
        <path d="M12 2a7 7 0 0 0-7 7c0 5.3 7 13 7 13s7-7.7 7-13a7 7 0 0 0-7-7Zm0 9.5a2.5 2.5 0 1 1 0-5 2.5 2.5 0 0 1 0 5Z" />
      </svg>
    </div>

    <span class="absolute left-4 top-4 rounded-full border border-line bg-ink/70 px-3 py-1 text-xs text-mist backdrop-blur">
      Map preview · placeholder
    </span>
  </div>

  <div class="flex flex-col gap-4 border-t border-line p-5 sm:flex-row sm:items-center sm:justify-between">
    <div>
      <p class="font-display text-lg font-semibold">{site.name}</p>
      <p class="text-sm text-mist">{site.address}</p>
    </div>
    <div class="flex flex-wrap gap-2">
      <a class="btn btn-secondary btn-sm" href={`https://www.google.com/maps/search/?api=1&query=${query}`} target="_blank" rel="noopener noreferrer">
        Open in Maps
      </a>
      <a class="btn btn-primary btn-sm" href={`https://www.google.com/maps/dir/?api=1&destination=${query}`} target="_blank" rel="noopener noreferrer">
        Get directions
      </a>
    </div>
  </div>
</div>

<style>
  .map-pulse {
    animation: map-pulse 2.2s ease-out infinite;
  }
  @keyframes map-pulse {
    0% { transform: translate(-50%, -50%) scale(0.4); opacity: 0.9; }
    100% { transform: translate(-50%, -50%) scale(2.2); opacity: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .map-pulse { animation: none; }
  }
</style>
